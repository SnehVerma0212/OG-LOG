# Copy to `.env.integration.local` (git-ignored) and fill in locally.
# NEVER commit real values, and never paste them into chat.
# Development project with SYNTHETIC data only. See supabase/DEVELOPMENT.md.

# Project URL: https://<project-ref>.supabase.co (or http://127.0.0.1:54321 for the local stack)
OGLOG_IT_SUPABASE_URL=

# Publishable key (sb_publishable_...) or legacy anon key. NEVER a secret/service-role key.
OGLOG_IT_SUPABASE_PUBLISHABLE_KEY=

# Two fictional test accounts created in the dashboard (Authentication > Users > Add user, auto-confirm).
OGLOG_IT_USER_A_EMAIL=
OGLOG_IT_USER_A_PASSWORD=
OGLOG_IT_USER_B_EMAIL=
OGLOG_IT_USER_B_PASSWORD=

# Must be exactly: synthetic-dev-project
OGLOG_IT_CONFIRM=
