# Copy to `.env.local` (git-ignored) and fill in locally. NEVER commit real values.
# These two values are built into the website and visible to anyone who loads it,
# which is expected for these two only. Row Level Security protects the data.
# Development project with SYNTHETIC data only. See supabase/DEVELOPMENT.md.

# Project URL: https://<project-ref>.supabase.co (or http://127.0.0.1:54321 for the local stack)
VITE_SUPABASE_URL=

# Publishable key (sb_publishable_...) or legacy anon key.
# NEVER a secret or service-role key: it bypasses Row Level Security. The app refuses to start with one.
VITE_SUPABASE_PUBLISHABLE_KEY=
